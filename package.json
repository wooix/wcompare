{
  "name": "wcompare",
  "version": "0.1.0",
  "buildVersion": "2026-10-10-004",
  "description": "Simple side-by-side file compare with syntax, lint, vim",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch & electron .",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "e2e": "npm run build && playwright test",
    "package:mac": "node scripts/bump-version.mjs && npm run build && node scripts/pack-mac.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.12",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4",
    "pdfjs-dist": "^6.0.227"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "electron": "^42.4.0",
    "esbuild": "^0.28.1"
  }
}
