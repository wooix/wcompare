{
  "name": "wcompare",
  "version": "0.1.0",
  "description": "Simple side-by-side file compare with syntax, lint, vim",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node esbuild.mjs",
    "dev": "node esbuild.mjs --watch & electron .",
    "start": "electron .",
