    "e2e": "npm run build && playwright test"
  },
  "license": "MIT",
  "dependencies": {
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "electron": "^42.4.0",
    "esbuild": "^0.28.1"
  }
}
